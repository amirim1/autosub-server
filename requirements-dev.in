-r requirements.in

# pip-tools 7.6.0 imports a pip API removed in pip 26.2.
pip<26.2
# stevedore 5.9+ requires Python 3.11, while CI includes Python 3.10.
stevedore<5.9
pytest
pytest-asyncio
# pytest-asyncio needs this runner backport on Python 3.10. Keep it explicit so
# locks compiled on newer Python versions remain valid across the CI matrix.
backports-asyncio-runner==1.2.0 ; python_version < "3.11"
pytest-cov
ruff
pyright
bandit
pip-audit
pip-tools
