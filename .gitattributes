# Default: auto line endings
* text=auto

# Shell scripts must always use LF (Linux servers)
*.sh text eol=lf

# Python files: LF
*.py text eol=lf

# Config/data and documentation files: LF
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.env* text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
