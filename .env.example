AUTOSUB_HOST=127.0.0.1
AUTOSUB_PORT=25500
# Comma-separated reverse-proxy IPs/CIDRs whose forwarding headers are trusted.
# Empty disables forwarded-header trust; invalid or world-wide networks stop startup.
AUTOSUB_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Basic Auth credentials for /admin. Change the example password before use.
AUTOSUB_ADMIN_USERNAME=admin
# Empty is allowed only when AUTOSUB_HOST is 127.0.0.1, ::1, or localhost.
AUTOSUB_ADMIN_PASSWORD=change-me
# HMAC key for CSRF and future local cryptographic operations. Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTOSUB_SECRET_KEY=replace-with-a-random-secret

# Runtime code and assets are resolved from the active immutable release.
# Do not set legacy AUTOSUB_APP_DIR in the shared environment.

# SQLite database path (default: /opt/autosub-server/shared/data.db in production)
# AUTOSUB_DB=/opt/autosub-server/shared/data.db

# Original 3x-ui JSON subscription upstream.
XUI_SUB_URL=https://sub.your-domain.com:2096

# 3x-ui panel/API upstream. This is usually NOT the subscription port.
# Include the secret web base path if your panel uses one, for example:
# XUI_API_URL=https://panel.your-domain.com:54321/secretpath
XUI_API_URL=https://panel.your-domain.com:54321

# Recommended: 3x-ui Settings -> Security -> API Token.
# If set, AutoSub uses Authorization: Bearer and ignores XUI_USERNAME/XUI_PASSWORD.
XUI_API_TOKEN=

# Backward-compatible fallback. Leave equal to subscription URL if unsure.
XUI_URL=https://sub.your-domain.com:2096

# If you use https://127.0.0.1:2096 and certificate validation fails, set false.
XUI_TLS_VERIFY=true
XUI_USERNAME=admin
XUI_PASSWORD=change_me

# Override subscription title/name (e.g. "AT VPN").
# If empty, passes through the original 3x-ui header.
# SUB_TITLE=AT VPN

# Override subscription userinfo (traffic/expiry).
# Format: upload=0; download=0; total=107374182400; expire=1767225600
# If empty, passes through the original 3x-ui header.
# SUB_USERINFO=upload=0; download=0; total=107374182400; expire=1767225600

# Minimum health-check interval (anti-flapping floor) applied to generated
# balancer configs. Values below the floor are clamped. Accepts 90s / 5m / 1h.
# AUTOSUB_MIN_PROBE_INTERVAL=60s

# Public origin of subscription links, used inside client deep links on the
# landing page (e.g. https://sub.your-domain.com). Falls back to the request
# base URL when unset (may be wrong behind a reverse proxy).
# AUTOSUB_PUBLIC_URL=https://sub.your-domain.com

# Optional JSON overrides for landing download links:
# {"incy": {"downloads": {"android": "https://play.google.com/store/apps/details?id=..."}}}
# Only http(s) URLs are accepted; unknown platforms are ignored.
# AUTOSUB_LANDING_OVERRIDES=
