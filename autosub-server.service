[Unit]
Description=AutoSub JSON subscription proxy
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/autosub-server/current
Environment=AUTOSUB_ROOT=/opt/autosub-server
EnvironmentFile=/opt/autosub-server/shared/.env
ExecStart=/opt/autosub-server/current/venv/bin/python /opt/autosub-server/current/autosub_server.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/autosub-server/shared
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
