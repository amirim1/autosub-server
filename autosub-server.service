[Unit]
Description=AutoSub JSON subscription proxy
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/autosub-server/current
Environment=AUTOSUB_ROOT=/opt/autosub-server
EnvironmentFile=/opt/autosub-server/shared/.env
ExecStart=/opt/autosub-server/current/venv/bin/python /opt/autosub-server/current/autosub_server.py
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
